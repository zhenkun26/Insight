APP_NAME=Insight
APP_VERSION=0.1.0
ENVIRONMENT=local
HOST=0.0.0.0
PORT=8000
DATABASE_PATH=data/insight.db
BM25_INDEX_PATH=data/bm25.json
UPLOAD_DIR=data/uploads
MILVUS_URI=data/milvus.db
MILVUS_COLLECTION=insight_chunks
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
EMBEDDING_MODEL=nomic-embed-text
RERANKER_MODEL=
TOP_K=5
CANDIDATE_K=20
SCORE_THRESHOLD=0.01
CHUNK_SIZE=900
CHUNK_OVERLAP=120
RRF_K=60
REQUEST_TIMEOUT_SECONDS=60
ENABLE_RERANK=false
